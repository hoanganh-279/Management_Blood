# =============================================================================
# Biến môi trường mẫu — sao chép thành .env ở root repo và điền giá trị thật.
#   cp .env.example .env
# Backend (chạy từ backend/) đọc file root .env qua backend/app/config.py.
# KHÔNG commit file .env chứa secret.
# =============================================================================

# --- Backend (FastAPI) ---
PORT=8000
# Chuỗi kết nối Postgres từ Supabase (Connection string)
DATABASE_URL=sqlite:///./management_blood.db

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Chỉ dùng trên server — tuyệt đối không đưa vào React/Flutter
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_or_publishable_key
JWT_SECRET=change_me_to_a_long_random_string
# Danh sách origin được phép CORS, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Google OAuth (Web client từ Google Cloud Console) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Console → APIs & Services → Credentials → OAuth 2.0 Client (Web):
# Authorized JavaScript origins (bắt buộc, không path/trailing slash):
#   http://localhost:5173
#   http://127.0.0.1:5173
# Authorized redirect URIs (GIS popup):
#   http://localhost:5173
#   http://127.0.0.1:5173
# Lỗi 400 origin_mismatch = origin trình duyệt chưa có trong danh sách trên.
# Mở app bằng http://localhost:5173 (Vite đã khóa host/port trong vite.config.js).

# --- Admin web (React + Vite) ---
# Đặt trong admin-web/.env nếu tách file theo package (Vite chỉ đọc thư mục package)
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Client ID công khai (tuỳ chọn — admin-web cũng lấy từ GET /auth/google/config)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
